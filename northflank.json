{
  "$schema": "https://api.northflank.com/v1/schemas/template",
  "apiVersion": "v1.2",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "demo",
            "region": "europe-west"
          },
          "updateMode": "put"
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "CombinedService",
                "spec": {
                  "deployment": {
                    "instances": 1,
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 1024
                      },
                      "shmSize": 64
                    },
                    "docker": {
                      "configType": "default"
                    }
                  },
                  "loadBalancing": {
                    "mode": "leastConnection"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "dockerWorkDir": "/",
                      "dockerFilePath": "/Dockerfile",
                      "buildEngine": "buildkit",
                      "buildkit": {
                        "useCache": false,
                        "cacheStorageSize": 16384
                      }
                    },
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 16384
                      }
                    }
                  },
                  "ports": [
                    {
                      "internalPort": 8080,
                      "protocol": "HTTP",
                      "name": "p01",
                      "public": true,
                      "domains": [],
                      "security": {
                        "policies": [],
                        "credentials": [],
                        "securePathConfiguration": {
                          "rules": []
                        }
                      },
                      "disableNfDomain": false
                    }
                  ],
                  "billing": {
                    "deploymentPlan": "nf-compute-10",
                    "buildPlan": "nf-compute-400-16"
                  },
                  "runtimeEnvironment": {},
                  "runtimeFiles": {},
                  "buildArguments": {},
                  "buildFiles": {},
                  "dockerSecretMounts": {},
                  "infrastructure": {
                    "architecture": "x86"
                  },
                  "name": "demo",
                  "disabledCI": false,
                  "buildConfiguration": {
                    "pathIgnoreRules": [],
                    "isAllowList": false,
                    "ciIgnoreFlagsEnabled": false
                  },
                  "vcsData": {
                    "projectType": "github",
                    "accountLogin": "jas-atwal",
                    "projectUrl": "https://github.com/jas-atwal/northflank",
                    "projectBranch": "main"
                  }
                },
                "ref": "demo",
                "updateMode": "put"
              }
            ]
          }
        }
      ]
    }
  },
  "options": {
    "autorun": false,
    "concurrencyPolicy": "allow"
  },
  "gitops": {
    "repoUrl": "https://github.com/jas-atwal/northflank",
    "vcsService": "github",
    "accountLogin": "jas-atwal",
    "branch": "main",
    "filePath": "/northflank.json"
  }
}